# ============================================================================
# Agenda Online PTPN — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the .env file to version control.
# ============================================================================

APP_NAME="Agenda Online PTPN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ============================================================================
# Logging — Use 'daily' to auto-rotate logs; 'error' level for production
# ============================================================================
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_LEVEL=error

# ============================================================================
# Database — MySQL (production stack)
# ============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agenda_online
DB_USERNAME=root
DB_PASSWORD=

# Secondary database connection (cash_bank_new)
DB_CASHBANK_CONNECTION=mysql
DB_CASHBANK_HOST=127.0.0.1
DB_CASHBANK_PORT=3306
DB_CASHBANK_DATABASE=cash_bank_new
DB_CASHBANK_USERNAME=root
DB_CASHBANK_PASSWORD=

# ============================================================================
# Session & Cache
# ============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ============================================================================
# Broadcasting — Pusher (for real-time document notifications)
# ============================================================================
BROADCAST_CONNECTION=pusher

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================================================
# Mail
# ============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================================
# WhatsApp Notification — Fonnte Gateway
# Get your API token from: https://fonnte.com
# ============================================================================
FONNTE_API_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_COUNTRY_CODE=62
FONNTE_DELAY=5
WHATSAPP_NOTIFICATIONS_ENABLED=true
WHATSAPP_NOTIFICATION_COOLDOWN=24
NOTIFICATION_FALLBACK_EMAIL=true

# ============================================================================
# Vite
# ============================================================================
VITE_APP_NAME="${APP_NAME}"

VIRTUAL_ASSISTANT_PROVIDER=local
VIRTUAL_ASSISTANT_OPENAI_API_KEY=
VIRTUAL_ASSISTANT_OPENAI_MODEL=gpt-4o-mini
VIRTUAL_ASSISTANT_GEMINI_API_KEY=
VIRTUAL_ASSISTANT_GEMINI_MODEL=gemini-2.5-flash
VIRTUAL_ASSISTANT_DEFAULT_LIMIT=15
VIRTUAL_ASSISTANT_MAX_MESSAGE_LENGTH=800
